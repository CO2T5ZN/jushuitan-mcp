{
  "name": "jushuitan-mcp",
  "version": "0.1.0",
  "description": "聚水潭开放平台 API 文档 MCP Server —— 让 AI Agent 直接检索聚水潭开放 API 的分类、参数、错误码与示例",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jushuitan-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "fetch": "node dist/fetch-cli.js",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport=http",
    "test": "npm run build && node scripts/smoke-test.mjs && node scripts/smoke-test-http.mjs",
    "test:stdio": "npm run build && node scripts/smoke-test.mjs",
    "test:http": "npm run build && node scripts/smoke-test-http.mjs"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "jushuitan",
    "erp321",
    "聚水潭",
    "openapi",
    "erp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
